# Copy to .env  (Windows: copy .env.example .env)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Dashboard > Settings > API Keys > Publishable key. Safe to ship in the app because every table is protected
# by Row Level Security. NEVER put the secret key in this project.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
